{
  "host_to_main": {
    "$defs": {
      "DecimalInt": {
        "maxLength": 39,
        "pattern": "^(0|[1-9][0-9]*)$",
        "type": "string"
      },
      "Density": {
        "enum": [
          "full",
          "compact",
          "minimal"
        ],
        "type": "string"
      },
      "HostAction": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "open_float",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "open_stats",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "open_taskbar_settings",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "kind": {
                "const": "set_privacy",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "enabled"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "disable_taskbar",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "HostDisplayState": {
        "enum": [
          "disabled",
          "waiting_snapshot",
          "embedded",
          "unavailable"
        ],
        "type": "string"
      },
      "HostFailure": {
        "enum": [
          "os",
          "unsupported_version",
          "missing_taskbar",
          "unexpected_structure",
          "unsafe_geometry",
          "insufficient_space",
          "background_unavailable",
          "cleanup_timeout",
          "guardian_unavailable"
        ],
        "type": "string"
      },
      "HostReply": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "ready",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "heartbeat",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "kind": {
                "const": "privacy_applied",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "enabled"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "stopped",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "action": {
                "$ref": "#/$defs/HostAction"
              },
              "kind": {
                "const": "action",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "action"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "configured",
                "type": "string"
              },
              "settings_revision": {
                "$ref": "#/$defs/DecimalInt"
              }
            },
            "required": [
              "kind",
              "settings_revision"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "status",
                "type": "string"
              },
              "status": {
                "$ref": "#/$defs/HostStatus"
              }
            },
            "required": [
              "kind",
              "status"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "actions": {
                "items": {
                  "$ref": "#/$defs/HostAction"
                },
                "maxItems": 4,
                "type": "array"
              },
              "kind": {
                "const": "actions",
                "type": "string"
              },
              "settings_revision": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/DecimalInt"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "kind",
              "settings_revision",
              "actions"
            ],
            "type": "object"
          }
        ]
      },
      "HostRestore": {
        "enum": [
          "no_record",
          "restored",
          "already_restored",
          "external_change",
          "identity_lost",
          "failed",
          "uncertain"
        ],
        "type": "string"
      },
      "HostStatus": {
        "additionalProperties": false,
        "properties": {
          "density": {
            "anyOf": [
              {
                "$ref": "#/$defs/Density"
              },
              {
                "type": "null"
              }
            ]
          },
          "failure": {
            "anyOf": [
              {
                "$ref": "#/$defs/HostFailure"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_restore": {
            "anyOf": [
              {
                "$ref": "#/$defs/HostRestore"
              },
              {
                "type": "null"
              }
            ]
          },
          "settings_revision": {
            "anyOf": [
              {
                "$ref": "#/$defs/DecimalInt"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "$ref": "#/$defs/HostDisplayState"
          },
          "system_revision": {
            "$ref": "#/$defs/DecimalInt"
          }
        },
        "required": [
          "settings_revision",
          "system_revision",
          "state",
          "failure",
          "density",
          "last_restore"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "body": {
        "$ref": "#/$defs/HostReply"
      },
      "host_instance_id": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "nonce": {
        "maxLength": 64,
        "minLength": 64,
        "type": "string"
      },
      "protocol_version": {
        "format": "uint32",
        "maximum": 1,
        "minimum": 1,
        "type": "integer"
      },
      "sequence": {
        "$ref": "#/$defs/DecimalInt"
      }
    },
    "required": [
      "protocol_version",
      "host_instance_id",
      "nonce",
      "sequence",
      "body"
    ],
    "title": "Envelope",
    "type": "object"
  },
  "main_to_host": {
    "$defs": {
      "CoverageState": {
        "enum": [
          "complete",
          "partial",
          "unknown"
        ],
        "type": "string"
      },
      "DecimalInt": {
        "maxLength": 39,
        "pattern": "^(0|[1-9][0-9]*)$",
        "type": "string"
      },
      "DecimalMoney": {
        "maxLength": 40,
        "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,15})?$",
        "type": "string"
      },
      "EpochMs": {
        "maximum": 8640000000000000,
        "minimum": -8640000000000000,
        "type": "integer"
      },
      "HostConfiguration": {
        "additionalProperties": false,
        "properties": {
          "display": {
            "$ref": "#/$defs/TaskbarDisplayPreferences"
          },
          "enabled": {
            "type": "boolean"
          },
          "settings_revision": {
            "$ref": "#/$defs/DecimalInt"
          }
        },
        "required": [
          "settings_revision",
          "enabled",
          "display"
        ],
        "type": "object"
      },
      "HostCost": {
        "additionalProperties": false,
        "properties": {
          "currency": {
            "type": "string"
          },
          "estimated_cost": {
            "anyOf": [
              {
                "$ref": "#/$defs/DecimalMoney"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "currency",
          "estimated_cost"
        ],
        "type": "object"
      },
      "HostMessage": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "hello",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "snapshot",
                "type": "string"
              },
              "view": {
                "$ref": "#/$defs/TaskbarView"
              }
            },
            "required": [
              "kind",
              "view"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "kind": {
                "const": "privacy",
                "type": "string"
              },
              "settings_revision": {
                "$ref": "#/$defs/DecimalInt"
              }
            },
            "required": [
              "kind",
              "settings_revision",
              "enabled"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "heartbeat",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "configuration": {
                "$ref": "#/$defs/HostConfiguration"
              },
              "kind": {
                "const": "configure",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "configuration"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "get_status",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "get_actions",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "shutdown",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "HostQuota": {
        "additionalProperties": false,
        "properties": {
          "connection_epoch": {
            "type": "string"
          },
          "fetched_at_ms": {
            "anyOf": [
              {
                "$ref": "#/$defs/EpochMs"
              },
              {
                "type": "null"
              }
            ]
          },
          "limit_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "revision": {
            "$ref": "#/$defs/DecimalInt"
          },
          "state": {
            "$ref": "#/$defs/QuotaState"
          },
          "windows": {
            "items": {
              "$ref": "#/$defs/QuotaWindow"
            },
            "type": "array"
          }
        },
        "required": [
          "connection_epoch",
          "revision",
          "state",
          "limit_label",
          "fetched_at_ms",
          "windows"
        ],
        "type": "object"
      },
      "QuotaState": {
        "enum": [
          "disconnected",
          "connecting",
          "authorization_required",
          "unsupported",
          "ready",
          "stale",
          "error"
        ],
        "type": "string"
      },
      "QuotaWindow": {
        "additionalProperties": false,
        "properties": {
          "duration_mins": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "remaining_percent": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "resets_at_ms": {
            "anyOf": [
              {
                "$ref": "#/$defs/EpochMs"
              },
              {
                "type": "null"
              }
            ]
          },
          "used_percent": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "window_id": {
            "type": "string"
          }
        },
        "required": [
          "window_id",
          "duration_mins",
          "used_percent",
          "remaining_percent",
          "resets_at_ms"
        ],
        "type": "object"
      },
      "TaskbarDisplayLayout": {
        "enum": [
          "two_rows",
          "single_row"
        ],
        "type": "string"
      },
      "TaskbarDisplayPreferences": {
        "additionalProperties": false,
        "properties": {
          "layout": {
            "$ref": "#/$defs/TaskbarDisplayLayout"
          },
          "show_costs": {
            "type": "boolean"
          },
          "show_quota": {
            "type": "boolean"
          },
          "show_tokens": {
            "type": "boolean"
          },
          "show_weekly_reset": {
            "type": "boolean"
          }
        },
        "required": [
          "layout",
          "show_tokens",
          "show_costs",
          "show_quota",
          "show_weekly_reset"
        ],
        "type": "object"
      },
      "TaskbarView": {
        "additionalProperties": false,
        "description": "Display-only projection: no paths, SQL, credentials, conversation text or executable arguments.",
        "properties": {
          "cached_tokens": {
            "anyOf": [
              {
                "$ref": "#/$defs/DecimalInt"
              },
              {
                "type": "null"
              }
            ]
          },
          "costs": {
            "items": {
              "$ref": "#/$defs/HostCost"
            },
            "type": "array"
          },
          "generated_at_ms": {
            "$ref": "#/$defs/EpochMs"
          },
          "input_tokens": {
            "anyOf": [
              {
                "$ref": "#/$defs/DecimalInt"
              },
              {
                "type": "null"
              }
            ]
          },
          "output_tokens": {
            "anyOf": [
              {
                "$ref": "#/$defs/DecimalInt"
              },
              {
                "type": "null"
              }
            ]
          },
          "price_revision": {
            "$ref": "#/$defs/DecimalInt"
          },
          "priced_tokens": {
            "$ref": "#/$defs/DecimalInt"
          },
          "privacy": {
            "type": "boolean"
          },
          "quota": {
            "anyOf": [
              {
                "$ref": "#/$defs/HostQuota"
              },
              {
                "type": "null"
              }
            ]
          },
          "scope_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "settings_revision": {
            "$ref": "#/$defs/DecimalInt"
          },
          "timezone": {
            "type": "string"
          },
          "total_tokens": {
            "anyOf": [
              {
                "$ref": "#/$defs/DecimalInt"
              },
              {
                "type": "null"
              }
            ]
          },
          "unpriced_tokens": {
            "$ref": "#/$defs/DecimalInt"
          },
          "usage_revision": {
            "$ref": "#/$defs/DecimalInt"
          },
          "usage_status": {
            "$ref": "#/$defs/CoverageState"
          }
        },
        "required": [
          "settings_revision",
          "usage_revision",
          "price_revision",
          "generated_at_ms",
          "privacy",
          "scope_label",
          "timezone",
          "total_tokens",
          "input_tokens",
          "cached_tokens",
          "output_tokens",
          "usage_status",
          "costs",
          "priced_tokens",
          "unpriced_tokens",
          "quota"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "body": {
        "$ref": "#/$defs/HostMessage"
      },
      "host_instance_id": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "nonce": {
        "maxLength": 64,
        "minLength": 64,
        "type": "string"
      },
      "protocol_version": {
        "format": "uint32",
        "maximum": 1,
        "minimum": 1,
        "type": "integer"
      },
      "sequence": {
        "$ref": "#/$defs/DecimalInt"
      }
    },
    "required": [
      "protocol_version",
      "host_instance_id",
      "nonce",
      "sequence",
      "body"
    ],
    "title": "Envelope",
    "type": "object"
  },
  "maximum_frame_bytes": 65536,
  "protocol_version": 1
}
