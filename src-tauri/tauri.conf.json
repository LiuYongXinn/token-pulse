{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenPulse",
  "version": "0.1.7",
  "identifier": "com.tokenpulse.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "TokenPulse", "visible": false, "width": 1280, "height": 860, "minWidth": 960, "minHeight": 680, "backgroundColor": "#202020" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"] },
  "plugins": { "updater": { "pubkey": "", "requireSignedVersion": true, "allowDowngrades": false, "windows": { "installMode": "passive" } } }
}
