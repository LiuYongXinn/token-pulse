{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window with explicitly enumerated commands; no shell or filesystem API.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-get-app-status",
    "allow-get-taskbar-preferences",
    "allow-set-taskbar-preferences",
    "allow-get-taskbar-status",
    "allow-retry-taskbar-embed",
    "allow-get-account-quota",
    "allow-get-account-service-config",
    "allow-choose-account-service",
    "allow-cancel-account-service-selection",
    "allow-save-account-service-config",
    "allow-manage-account-connection",
    "allow-refresh-account-quota",
    "allow-get-mini-stats-request",
    "allow-get-main-navigation",
    "allow-get-mini-scope",
    "allow-query-mini-sessions",
    "allow-get-mini-usage",
    "allow-set-mini-scope",
    "allow-perform-window-action",
    "allow-get-sources",
    "allow-query-diagnostics",
    "allow-choose-source-directory",
    "allow-manage-source",
    "allow-start-job",
    "allow-get-job",
    "allow-list-jobs",
    "allow-get-rebuild-status",
    "allow-cancel-job",
    "allow-get-context-snapshot",
    "allow-get-price-rules",
    "allow-get-price-revalue-status",
    "allow-start-price-revalue",
    "allow-cancel-price-revalue",
    "allow-get-offline-price-catalog",
    "allow-save-price-rule",
    "allow-mutate-model-alias",
    "allow-retire-price-rule",
    "allow-get-dashboard-bundle",
    "allow-get-grouped-usage",
    "allow-get-filter-options",
    "allow-query-sessions",
    "allow-get-session-bundle",
    "allow-query-turns",
    "allow-resolve-calendar-selection",
    "allow-get-display-settings",
    "allow-set-display-timezone",
    "allow-set-display-theme",
    "allow-set-display-privacy",
    "allow-query-usage-events",
    "allow-close-query-snapshot",
    "allow-get-recovery-shortcut",
    "allow-set-recovery-shortcut",
    "allow-get-mini-opacity",
    "allow-set-mini-opacity",
    "allow-get-mini-passthrough",
    "allow-set-mini-passthrough"
  ]
}
