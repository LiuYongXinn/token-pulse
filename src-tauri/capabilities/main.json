{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window with explicitly enumerated commands; no shell or filesystem API.",
  "windows": ["main"],
  "permissions": ["core:default", "allow-get-app-status", "allow-get-mini-scope", "allow-get-mini-usage", "allow-set-mini-scope", "allow-perform-window-action", "allow-get-sources", "allow-choose-source-directory", "allow-manage-source", "allow-start-job", "allow-get-job", "allow-list-jobs", "allow-cancel-job", "allow-get-context-snapshot", "allow-get-price-rules", "allow-save-price-rule", "allow-retire-price-rule", "allow-get-dashboard-bundle", "allow-get-grouped-usage", "allow-get-filter-options", "allow-query-sessions", "allow-get-session-bundle", "allow-query-turns", "allow-resolve-calendar-selection", "allow-get-display-settings", "allow-set-display-timezone", "allow-set-display-theme", "allow-set-display-privacy", "allow-query-usage-events", "allow-close-query-snapshot"]
}
