{
  "name": "token-pulse",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:native": "pwsh -NoProfile -File scripts/native-smoke.ps1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "icons": "node scripts/generate-icons.mjs",
    "notices": "node scripts/generate-third-party-notices.mjs --target x86_64-pc-windows-msvc",
    "release:prepare": "node scripts/prepare-update-release.mjs",
    "release:sign": "pwsh -NoProfile -File scripts/sign-update-release.ps1",
    "contracts": "cargo run -p token-pulse-core --example export_contracts",
    "contracts:check": "cargo run -p token-pulse-core --example export_contracts -- --check"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^8.20.0",
    "typescript": "~6.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
